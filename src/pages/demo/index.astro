---
// D4 — the reviewer demo panel. A purpose-built, fully-styled Fern surface for
// handing the demo to a clinical lead (or CQC): pick a persona, land at the right
// point, and walk a deliberate happy or sad path on the real styled surfaces —
// without knowing any seed. Separate from /dev/harness (the raw developer tool).
//
// Everything here is dummy data on the MOCK adapters. The persona seeders drive
// the patient TO a clinician decision; they never auto-issue a script (the hard
// line). The destructive global purge touches only the throwaway mock_* tables.
import Layout from '../../layouts/Layout.astro';
import { createAdminClient } from '../../lib/supabase/admin';
import { ensureAccount, getJourney } from '../../lib/accounts';
import { PERSONAS } from '../../lib/demo/personas';

const { user, env } = Astro.locals;
if (!user) return Astro.redirect('/login');

const admin = createAdminClient(env);
const account = await ensureAccount(admin, user.id);
const journey = await getJourney(admin, account.id);

const error = Astro.url.searchParams.get('error');
const notice = Astro.url.searchParams.get('notice');
const role = account.role;
---

<Layout title="Reviewer demo — Fern" navVariant="onboarding" user={user} narrow={false}>
  <div class="wrap">
    <div class="stack">
      <span class="eyebrow">Reviewer demo</span>
      <h1>Walk the Fern demo</h1>
      <p class="lede">
        Pick a path below. Each one sets up a patient and lands you at the point
        where something happens, so you can walk it to its end on the real
        screens. Everything is dummy data on test services; no real patients, no
        live care.
      </p>
    </div>

    {error && <p class="notice notice-error top">{error}</p>}
    {notice && <p class="notice notice-info top">{notice}</p>}

    <!-- Where you are now: live account state + the role switch + a clean reset. -->
    <section class="card state-card top" aria-labelledby="state-h">
      <h2 id="state-h">Where you are now</h2>
      <dl class="state-grid">
        <div>
          <dt>You are acting as</dt>
          <dd><span class="pill">{role}</span></dd>
        </div>
        <div>
          <dt>Journey state</dt>
          <dd><code>{journey?.state ?? '(none)'}</code></dd>
        </div>
        <div>
          <dt>Lane</dt>
          <dd><code>{journey?.lane ?? '(none)'}</code></dd>
        </div>
        <div>
          <dt>Account</dt>
          <dd><code>{account.id}</code></dd>
        </div>
      </dl>

      <div class="state-actions">
        <form method="POST" action="/api/demo/role">
          <input type="hidden" name="role" value={role === 'clinician' ? 'patient' : 'clinician'} />
          <input type="hidden" name="return" value="/demo" />
          <button type="submit" class="btn btn-ghost">
            Switch to {role === 'clinician' ? 'patient' : 'clinician'}
          </button>
        </form>
        <form method="POST" action="/api/demo/persona">
          <input type="hidden" name="persona" value="reset" />
          <button type="submit" class="btn btn-ghost">Reset to a clean slate</button>
        </form>
      </div>
      <p class="soft note">
        One account, two roles. Some walks ask you to switch role partway through
        (the panel link does it). Use the surface navs to move; come back to
        <code>/demo</code> to pick another path.
      </p>
    </section>

    <!-- The six curated paths. -->
    <h2 class="paths-h">Choose a path</h2>
    <div class="personas">
      {
        PERSONAS.map((p) => (
          <article class="card persona">
            <div class="persona-head">
              <h3>{p.title}</h3>
              <span class:list={['pill', p.role === 'clinician' ? 'pill-soft' : '']}>
                starts as {p.role}
              </span>
            </div>
            <p class="who">{p.name}</p>
            <p class="summary">{p.summary}</p>
            <p class="walk"><span class="walk-tag">You</span>{p.walk}</p>
            <form method="POST" action="/api/demo/persona">
              <input type="hidden" name="persona" value={p.id} />
              <button type="submit" class="btn btn-pri btn-block">
                {p.terminal ? 'Show this outcome' : 'Start this walk'}
              </button>
            </form>
          </article>
        ))
      }
    </div>

    <!-- Fenced destructive control: wipe all demo data for a fresh handover. -->
    <section class="card danger top" aria-labelledby="purge-h">
      <h2 id="purge-h">Reset for a fresh handover</h2>
      <p class="muted">
        Purges all demonstration data (the throwaway mock records behind every
        persona) across the whole demo, so the next person starts clean. This
        only clears dummy demo data; it does not remove any accounts or sign-ins.
      </p>
      <details class="purge-fence">
        <summary>Purge all demo data</summary>
        <form method="POST" action="/api/demo/purge" class="purge-form">
          <label class="choice confirm-row">
            <input type="checkbox" name="confirm" value="purge" required />
            <span>I understand this wipes all demonstration data.</span>
          </label>
          <button type="submit" class="btn btn-danger">Purge all demo data</button>
        </form>
      </details>
    </section>
  </div>
</Layout>

<style>
  .top { margin-top: 24px; }
  .state-card h2 { font-size: 20px; margin-bottom: 18px; }

  .state-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px 24px;
    margin: 0 0 22px;
  }
  .state-grid dt {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--soft);
    margin-bottom: 6px;
  }
  .state-grid dd { margin: 0; }
  .state-grid code { font-family: var(--mono); font-size: 13px; word-break: break-all; }

  .state-actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .note { margin-top: 16px; font-size: 13px; }
  .note code, .summary code { font-family: var(--mono); font-size: 12.5px; }

  .paths-h { margin: 40px 0 18px; }
  .personas {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
  }
  .persona { display: flex; flex-direction: column; }
  .persona-head {
    display: flex; align-items: flex-start; justify-content: space-between;
    gap: 12px; margin-bottom: 8px;
  }
  .persona-head h3 { font-size: 19px; }
  .persona .pill { flex: none; white-space: nowrap; }
  .who {
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--faint);
    margin-bottom: 14px;
  }
  .summary { color: var(--muted); font-size: 14.5px; }
  .walk {
    color: var(--text);
    font-size: 14px;
    background: var(--cream-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-box, 16px);
    padding: 12px 14px;
    margin: 14px 0 18px;
  }
  .walk-tag {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--navy);
    background: var(--peri);
    border-radius: 999px;
    padding: 2px 8px;
    margin-right: 8px;
  }
  .persona form { margin-top: auto; }

  /* Fenced destructive zone: warn-tinted, disclosure-gated, confirm-required. */
  .danger { border-color: rgba(181, 86, 78, 0.4); }
  .danger h2 { font-size: 20px; margin-bottom: 10px; }
  .purge-fence { margin-top: 16px; }
  .purge-fence summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--fern-warn);
    font-size: 14.5px;
  }
  .purge-form { margin-top: 16px; }
  .confirm-row { margin-bottom: 16px; }
  .btn-danger {
    background: var(--fern-warn);
    color: #fff;
  }
  .btn-danger:hover { transform: translateY(-1px); }
</style>
