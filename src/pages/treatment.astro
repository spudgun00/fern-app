---
// P4 patient "your treatment" view: the current script (the patient's own
// clinical record, read server-side from the core for display), the dispensing
// status, and the delivery tracking. A member can lodge a repeat request, which
// enters the clinician review queue.
//
// Copy stays plain and factual: this shows the patient their own prescription
// record and its dispensing progress, never promotional / marketing-style copy.
// Styled onto the D1 shell (D2); all view logic + the form actions are unchanged.
import Layout from '../layouts/Layout.astro';
import { createAdminClient } from '../lib/supabase/admin';
import { getClinicalCore, getDispensing } from '../lib/adapters/factory';
import { ensureAccount, getJourney } from '../lib/accounts';
import { getTreatmentView } from '../lib/dispensing/dispense';
import { flagsFromEnv } from '../lib/cta';
import { getProduct } from '../lib/checkout/products';
import {
  dispensingAwaitsMedicationPayment,
  medicationBillingFromEnv,
} from '../lib/medication/medication';

const { user, env } = Astro.locals;
if (!user) return Astro.redirect('/login');

const admin = createAdminClient(env);
const account = await ensureAccount(admin, user.id);
if (account.role === 'clinician') return Astro.redirect('/clinician');
if (!account.core_patient_id) return Astro.redirect('/account/profile');

const journey = await getJourney(admin, account.id);
const core = getClinicalCore(env, admin);
const dispensing = getDispensing(env, admin);
const view = await getTreatmentView(admin, core, dispensing, account.id, account.core_patient_id);

const error = Astro.url.searchParams.get('error');
const notice = Astro.url.searchParams.get('notice');

const STATUS_COPY: Record<string, string> = {
  submitted: 'Sent to the pharmacy',
  dispatched: 'Dispatched by the pharmacy',
  delivered: 'Delivered',
};
const statusLabel = (s: string | undefined) => (s ? (STATUS_COPY[s] ?? s) : 'Not yet sent');
const isMock = env.DISPENSING_IMPL !== 'stripe' && env.DISPENSING_IMPL !== 'cloudrx';

// C1: the repeat + membership actions are purchase CTAs; they only render when
// the purchase funnel is on. Off (pre-CQC default) hides them (the prescription
// record + dispensing status remain visible; neither is purchase copy).
const flags = flagsFromEnv(env);

// C5 (Journey F): when medication is a per-fill charge and the funnel is on, a
// clinician-issued script (rx_issued) waits for the patient to confirm + pay for
// their medication before it is dispensed. Resolve the patient's medication
// product under the flags (menopause is the primary door; weight only when
// weightLossRx is on) — it names no medicine, so the copy stays POM-safe.
const awaitsMedication = dispensingAwaitsMedicationPayment(flags, medicationBillingFromEnv(env));
const medicationProduct =
  getProduct('menopause_medication', flags) ?? getProduct('weight_medication', flags);
const showMedicationConfirm =
  flags.purchaseEnabled &&
  awaitsMedication &&
  journey?.state === 'rx_issued' &&
  !view.dispense &&
  Boolean(view.script) &&
  Boolean(medicationProduct);
// C5 (Journey G): the optional add-ons appear once treatment is under way
// (a dispense exists). Both are ungated by any Rx flag; funnel-gated only.
const showAddons = flags.purchaseEnabled && Boolean(view.dispense);
---

<Layout title="Your treatment — Fern" navVariant="patient" user={user} active="/treatment" narrow step={6}>
  <div class="wrap-narrow">
    <div class="stack">
      <span class="eyebrow">Your care</span>
      <h1>Your treatment</h1>
    </div>

    {error && <p class="notice notice-error top-notice">{error}</p>}
    {notice && <p class="notice notice-info top-notice">{notice}</p>}

    {
      !view.script ? (
        <div class="card step-card stack">
          <span class="pill pill-soft">No prescription yet</span>
          <p class="muted">
            You do not have an issued prescription yet. Once a clinician has
            reviewed your intake and approved treatment, your prescription and its
            dispensing progress will appear here.
          </p>
          <p class="soft devline">
            <span class="dev-tag">Demo detail</span>
            state <code>{journey?.state}</code>
          </p>
        </div>
      ) : (
        <>
          <div class="card rx-card top-notice">
            <div class="rx-head">
              <h2>Your current prescription</h2>
              <span class="pill">Issued by a clinician</span>
            </div>
            <p class="muted">This is your prescription record, issued by a clinician.</p>
            <ul class="rx-items">
              {view.script.request.items.map((it) => (
                <li>
                  <span class="rx-name">{it.name}</span>
                  {it.dose ? <span class="rx-meta"> &middot; {it.dose}</span> : ''}
                  {it.quantity ? <span class="rx-meta"> &middot; quantity {it.quantity}</span> : ''}
                </li>
              ))}
            </ul>
            <p class="soft issued">
              Issued {new Date(view.script.issuedAt).toLocaleString('en-GB')}
            </p>
          </div>

          {showMedicationConfirm && medicationProduct && (
            <div class="card confirm-card">
              <div class="rx-head">
                <h2>Confirm your medication</h2>
                <span class="pill pill-soft">Demo stand-in</span>
              </div>
              <p class="muted repeat-copy">
                Your clinician has prescribed your treatment. Confirm to arrange
                dispensing and delivery from our pharmacy partner. The cost is passed
                through at cost, with any prescriber fee where applicable. This pays
                for dispensing; it does not change your prescription.
              </p>
              <a href={`/checkout?product=${medicationProduct.id}`} class="btn btn-pri">
                Confirm your medication
              </a>
            </div>
          )}

          <div class="card">
            <div class="rx-head">
              <h2>Dispensing</h2>
              <span class={`pill ${view.status?.status === 'delivered' ? '' : 'pill-soft'}`}>
                {statusLabel(view.status?.status)}
              </span>
            </div>
            <p class="muted">
              Dispensed by our pharmacy partner, a GPhC-registered pharmacy.
            </p>

            <h3 class="track-h">Tracking</h3>
            {view.tracking && view.tracking.events.length > 0 ? (
              <ol class="track">
                {view.tracking.events.map((e) => (
                  <li>
                    <span class="track-at">{new Date(e.at).toLocaleString('en-GB')}</span>
                    <span class="track-desc">{e.description}</span>
                  </li>
                ))}
              </ol>
            ) : (
              <p class="soft">No tracking updates yet.</p>
            )}
          </div>

          {flags.purchaseEnabled && view.dispense && (
            <div class="card">
              <h2>Repeat</h2>
              {view.canRequestRepeat ? (
                <>
                  <p class="muted repeat-copy">
                    If you are due to continue this treatment, you can request a
                    repeat. Your membership covers it at no extra consultation
                    charge, and a clinician reviews every repeat before it is
                    dispensed.
                  </p>
                  <form method="POST" action="/api/treatment/repeat">
                    <button type="submit" class="btn btn-pri">Request a repeat</button>
                  </form>
                </>
              ) : (
                <p class="muted repeat-copy">
                  Repeat prescriptions are covered by membership.{' '}
                  <a href="/account/billing" class="link">Subscribe to membership</a> to
                  request repeats reviewed by a clinician at no extra consultation charge.
                </p>
              )}
            </div>
          )}

          {showAddons && (
            <div class="card addons-card">
              <h2>Optional extras</h2>
              <p class="muted repeat-copy">
                Optional add-ons for your care. Neither is a medicine, and neither
                changes your treatment.
              </p>
              <div class="addons">
                <div class="addon">
                  <span class="addon-name">Side-effect support kit</span>
                  <span class="addon-desc">Comfort items for common early side effects, posted to you.</span>
                  <a href="/checkout?product=addon_kit" class="btn btn-ghost">Add support kit</a>
                </div>
                <div class="addon">
                  <span class="addon-name">Repeat health screen</span>
                  <span class="addon-desc">Ongoing monitoring, every 6 to 12 months. A clinician reviews each result.</span>
                  <a href="/checkout?product=rescreen" class="btn btn-ghost">Set up re-screen</a>
                </div>
              </div>
            </div>
          )}

          {env.DEV_TOOLS_ENABLED && isMock && view.dispense && view.status?.status !== 'delivered' && (
            <div class="dev-panel">
              <span class="pill pill-soft">Demo control</span>
              <p class="muted dev-copy">
                Step the dispensing status forward (submitted &rarr; dispatched
                &rarr; delivered). In the live service the pharmacy pushes these
                updates itself.
              </p>
              <form method="POST" action="/api/dev/advance-dispense">
                <button type="submit" class="btn btn-ghost">Advance dispensing status</button>
              </form>
            </div>
          )}
        </>
      )
    }
  </div>
</Layout>

<style>
  .top-notice { margin-top: 24px; }
  .step-card .devline { margin-top: 4px; }
  .rx-head { display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; }
  .rx-head h2 { font-size: 22px; }
  .rx-card .muted { margin-top: 8px; }
  .rx-items { list-style: none; margin: 16px 0 0; padding: 0; }
  .rx-items li {
    padding: 12px 14px;
    background: var(--cream-2);
    border: 1px solid var(--border);
    border-radius: 12px;
  }
  .rx-items li + li { margin-top: 8px; }
  .rx-name { font-weight: 600; color: var(--navy); }
  .rx-meta { color: var(--muted); font-size: 14.5px; }
  .issued { margin-top: 14px; font-size: 13px; }

  .track-h { font-size: 16px; margin-top: 20px; }
  .track { list-style: none; margin: 12px 0 0; padding: 0; }
  .track li {
    position: relative;
    padding: 0 0 16px 22px;
    border-left: 2px solid var(--border);
  }
  .track li:last-child { padding-bottom: 0; border-left-color: transparent; }
  .track li::before {
    content: '';
    position: absolute;
    left: -6px; top: 3px;
    width: 10px; height: 10px;
    border-radius: 999px;
    background: var(--peri);
    border: 2px solid var(--navy);
  }
  .track-at { display: block; font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.04em; color: var(--soft); }
  .track-desc { display: block; font-size: 14.5px; color: var(--text); margin-top: 2px; }

  .repeat-copy { margin-top: 6px; }

  .confirm-card .btn { margin-top: 14px; }
  .addons { display: grid; gap: 14px; margin-top: 14px; }
  @media (min-width: 620px) { .addons { grid-template-columns: 1fr 1fr; } }
  .addon {
    display: flex; flex-direction: column; gap: 6px;
    padding: 16px; background: var(--cream-2);
    border: 1px solid var(--border); border-radius: 14px;
  }
  .addon-name { font-weight: 600; color: var(--navy); }
  .addon-desc { color: var(--muted); font-size: 14px; line-height: 1.55; }
  .addon .btn { margin-top: 8px; align-self: flex-start; }

  .dev-panel {
    margin-top: 20px;
    padding: 18px 20px;
    background: var(--cream-2);
    border: 1px dashed var(--border-d);
    border-radius: var(--radius-box, 16px);
  }
  .dev-copy { margin: 10px 0 14px; font-size: 14px; }

  .devline { font-size: 12.5px; }
  .dev-tag {
    font-family: var(--mono); font-size: 10px; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--faint); margin-right: 8px;
  }
  code { font-family: var(--mono); font-size: 12.5px; }
  h2 { font-size: 22px; }
</style>
