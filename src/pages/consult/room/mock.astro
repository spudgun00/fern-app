---
// In-app stand-in for the embedded provider video room (Daily), used only when
// VIDEO_IMPL=mock. It plays the role of the embedded call: both patient and
// clinician "join" the same room ref here. No real call happens; this is a dev
// affordance so the full-lane walk is end-to-end on the deployed URL. The real
// Daily room replaces this page entirely. Styled onto the D1 shell (D2).
import Layout from '../../../layouts/Layout.astro';
const { user } = Astro.locals;
if (!user) return Astro.redirect('/login');

const room = Astro.url.searchParams.get('room') ?? '';
---

<Layout title="Consult room — Fern" navVariant="patient" user={user} narrow>
  <div class="wrap-narrow">
    <div class="stack">
      <span class="pill pill-soft">Demo stand-in</span>
      <h1>Your consult room</h1>
      <p class="lede">
        This stands in for the embedded video consultation. No real call takes
        place. Both patient and clinician join the same room at the appointment
        time.
      </p>
    </div>

    <div class="stage card">
      <div class="stage-inner">
        <span class="cam" aria-hidden="true"></span>
        <p class="stage-label">Video consultation</p>
        <p class="stage-sub muted">The live room renders here in the demonstration build.</p>
      </div>
    </div>

    <p class="soft devline">
      <span class="dev-tag">Room</span><code>{room || 'none'}</code>
    </p>

    <p class="back"><a href="/consult" class="link">Back to your consultation</a></p>
  </div>
</Layout>

<style>
  .stage {
    margin-top: 24px;
    background: var(--navy);
    border-color: var(--border-d);
    padding: 0;
    overflow: hidden;
  }
  .stage-inner {
    aspect-ratio: 16 / 9;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 24px;
    gap: 6px;
  }
  .cam {
    width: 44px; height: 30px;
    border: 2px solid var(--peri);
    border-radius: 7px;
    position: relative;
    margin-bottom: 12px;
  }
  .cam::after {
    content: '';
    position: absolute;
    right: -13px; top: 50%;
    transform: translateY(-50%);
    border-top: 8px solid transparent;
    border-bottom: 8px solid transparent;
    border-left: 11px solid var(--peri);
  }
  .stage-label { font-family: var(--disp); font-size: 19px; color: var(--inv); }
  .stage-sub { color: var(--inv-muted); font-size: 14px; }
  .devline { margin-top: 18px; font-size: 12.5px; }
  .dev-tag {
    font-family: var(--mono); font-size: 10px; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--faint); margin-right: 8px;
  }
  code { font-family: var(--mono); font-size: 12.5px; }
  .back { margin-top: 20px; }
</style>
