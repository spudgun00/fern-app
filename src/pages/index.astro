---
import Layout from '../layouts/Layout.astro';
import { entryCta, flagsFromEnv } from '../lib/cta';
const { user, env } = Astro.locals;

// The entry-CTA switch (C1). Off by default -> "Get early access" -> waitlist.
// On -> the purchase funnel (account -> ID -> intake). The weight door only
// exists when weightLossRx is on (menoCta is always present).
const flags = flagsFromEnv(env);
const menoCta = entryCta('menopause', flags);
const weightCta = entryCta('weight', flags);
---
{
  user ? (
    <Layout title="Fern patient zone" navVariant="patient" user={user} active="/dashboard">
      <div class="wrap-narrow stack-lg">
        <div>
          <span class="eyebrow">Patient zone</span>
          <h1>Welcome back</h1>
          <p class="lede">
            Signed in as {user.email}. Pick up where you left off, or jump
            straight to your care.
          </p>
        </div>
        <div class="card stack">
          <h2>Your care</h2>
          <p class="muted">
            Your dashboard brings together your plan, treatment and next steps.
          </p>
          <div class="row">
            <a href="/dashboard" class="btn btn-pri">Go to dashboard</a>
            <a href="/treatment" class="btn btn-ghost">Your treatment</a>
          </div>
        </div>
        {env.DEV_TOOLS_ENABLED && (
          <p class="soft devline">
            Building this demo? The <a href="/dev/harness" class="link">dev harness</a> seeds and
            drives the journeys.
          </p>
        )}
      </div>
    </Layout>
  ) : (
    <Layout title="Fern patient zone" navVariant="public" user={null}>
      <div class="wrap-narrow stack-lg">
        <div>
          <span class="eyebrow">Patient zone</span>
          <h1>Menopause care, <em>online</em></h1>
          <p class="lede">
            Clinician-led perimenopause and menopause care, guideline-led and
            properly governed.
          </p>
        </div>
        <div class="row">
          {menoCta && <a href={menoCta.href} class="btn btn-pri">{menoCta.label}</a>}
          <a href="/login" class="btn btn-ghost">Log in</a>
        </div>

        {
          weightCta && (
            <div class="card door stack">
              <span class="eyebrow">Weight and metabolic health</span>
              <h2>A second front door, same clinician-led service</h2>
              <p class="muted">
                Screening-led weight and metabolic care, on the same regulated
                service.
              </p>
              <a href={weightCta.href} class="btn btn-pri door-cta">{weightCta.label}</a>
            </div>
          )
        }

        <p class="soft">
          This is a demonstration on dummy data.
          <a href="/about-this-demo" class="link">About this demo</a>
        </p>
      </div>
    </Layout>
  )
}

<style>
  .row { display: flex; flex-wrap: wrap; gap: 14px; }
  .devline { padding-top: 8px; }
  .door { align-items: flex-start; }
  .door h2 { font-size: 20px; }
  .door-cta { align-self: flex-start; }
</style>
