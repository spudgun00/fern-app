---
// P5 billing hub: the money surface. Shows the consult fee (one-off, gates the
// full-lane booking + first script) and the membership (recurring, covers
// repeats), plus the billing-portal entry. Styled onto the D1 shell (D2); all
// view logic + the form actions are unchanged. Copy stays plain and factual; the
// public-site figures (~£100 consult, ~£18/mo membership) are shown transparently
// with no efficacy claims.
import Layout from '../../layouts/Layout.astro';
import WaitlistCta from '../../components/WaitlistCta.astro';
import { createAdminClient } from '../../lib/supabase/admin';
import { ensureAccount, getJourney } from '../../lib/accounts';
import { getBillingView } from '../../lib/payments/billing';
import { flagsFromEnv } from '../../lib/cta';

const { user, env } = Astro.locals;
if (!user) return Astro.redirect('/login');

const admin = createAdminClient(env);
const account = await ensureAccount(admin, user.id);
if (account.role === 'clinician') return Astro.redirect('/clinician');

const journey = await getJourney(admin, account.id);
const view = await getBillingView(admin, account.id);

const error = Astro.url.searchParams.get('error');
const notice = Astro.url.searchParams.get('notice');

const memberStatus = view.membership?.status ?? 'inactive';

// C1: the purchase surface only renders when the purchase funnel is on. Off
// (pre-CQC default) shows the waitlist and NO price/subscription copy.
const flags = flagsFromEnv(env);
---

<Layout title="Membership and billing — Fern" navVariant="patient" user={user} narrow step={4}>
  <div class="wrap-narrow">
    <div class="stack">
      <span class="eyebrow">Your account</span>
      <h1>Membership and billing</h1>
    </div>

    {error && <p class="notice notice-error top-notice">{error}</p>}
    {notice && <p class="notice notice-info top-notice">{notice}</p>}

    {!flags.purchaseEnabled && <WaitlistCta href={flags.waitlistUrl} />}
    {flags.purchaseEnabled && (
    <>
    <div class="card price-card top-notice">
      <div class="price-head">
        <h2>Consultation fee</h2>
        <span class="amount">&pound;100<span class="per"> one-off</span></span>
      </div>
      <p class="muted">
        A first prescription follows an assessed consultation, charged as a
        one-off fee of around &pound;100. Paying it lets you book your consult.
      </p>
      {
        view.consultPaid ? (
          <div class="state-row">
            <span class="pill">Paid</span>
            <a href="/consult" class="btn btn-pri">Book your consultation</a>
          </div>
        ) : (
          <>
            {view.consultPending && (
              <p class="notice notice-soft pending">
                A previous payment is still being confirmed. Reload after paying.
              </p>
            )}
            <form method="POST" action="/api/payments/checkout/start" class="pay-form">
              <input type="hidden" name="kind" value="consult" />
              <button type="submit" class="btn btn-pri">Pay the consultation fee (&pound;100)</button>
            </form>
          </>
        )
      }
    </div>

    <div class="card price-card">
      <div class="price-head">
        <h2>Membership</h2>
        <span class="amount">&pound;18<span class="per"> / month</span></span>
      </div>
      <p class="muted">
        Membership is around &pound;18 a month and covers your ongoing care,
        including repeat prescriptions reviewed by a clinician at no extra
        consultation charge.
      </p>
      {
        view.isMember ? (
          <div class="state-row">
            <span class="pill">Active</span>
            <form method="POST" action="/api/payments/portal">
              <button type="submit" class="btn btn-ghost">Manage or cancel membership</button>
            </form>
          </div>
        ) : (
          <>
            {memberStatus === 'canceled' && (
              <p class="notice notice-soft pending">
                Your membership is cancelled. You can subscribe again below.
              </p>
            )}
            <form method="POST" action="/api/payments/checkout/start" class="pay-form">
              <input type="hidden" name="kind" value="membership" />
              <button type="submit" class="btn btn-pri">Subscribe to membership (&pound;18/mo)</button>
            </form>
          </>
        )
      }
    </div>
    </>
    )}

    <p class="soft devline">
      <span class="dev-tag">Demo detail</span>
      membership <code>{memberStatus}</code> &middot; state <code>{journey?.state}</code>
    </p>
  </div>
</Layout>

<style>
  .top-notice { margin-top: 24px; }
  .price-card + .price-card { margin-top: 18px; }
  .price-head {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 14px; flex-wrap: wrap; margin-bottom: 10px;
  }
  .price-head h2 { font-size: 22px; }
  .amount { font-family: var(--disp); font-size: 26px; font-weight: 600; color: var(--navy); }
  .per { font-family: var(--body); font-size: 14px; font-weight: 400; color: var(--soft); }
  .state-row { display: flex; align-items: center; gap: 16px; margin-top: 18px; flex-wrap: wrap; }
  .pay-form { margin-top: 18px; }
  .pending { margin-top: 16px; }

  .devline { margin-top: 22px; font-size: 12.5px; }
  .dev-tag {
    font-family: var(--mono); font-size: 10px; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--faint); margin-right: 8px;
  }
  code { font-family: var(--mono); font-size: 12.5px; }
</style>
