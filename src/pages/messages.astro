---
import Layout from '../layouts/Layout.astro';
import Coming from '../components/Coming.astro';
const { user } = Astro.locals;
if (!user) return Astro.redirect('/login');
---
<Layout title="Messages — Fern" navVariant="patient" user={user} active="/messages">
  <Coming
    eyebrow="Secure messaging"
    title="Messages"
    blurb="A private, secure channel to your clinical team between appointments, so the conversation continues after your care begins."
  />
</Layout>
