---
// P6 clinician console — consult detail + the decision action bar (full lane).
// Role-gated. Reads the patient's intake from the core (server-side, for display,
// never copied app-side) and the video room join link, then offers the same hard
// line as P3: Issue script | Refuse + signpost. Escalate is omitted because the
// assessed lane is itself the escalation target. Every action requires a reason.
// Styled onto the D1 shell (D3); the decision logic + form actions are unchanged.
import Layout from '../../../layouts/Layout.astro';
import { createAdminClient } from '../../../lib/supabase/admin';
import { getClinicalCore, getScreening, getVideo } from '../../../lib/adapters/factory';
import {
  ensureAccount,
  getAccountById,
  getBookingRefById,
  getJourney,
  getLatestIntakeRef,
} from '../../../lib/accounts';
import { SYMPTOM_OPTIONS, SCREEN_QUESTIONS } from '../../../lib/intake/questionnaire';
import type { IntakeAnswers, RoutingDecision } from '../../../lib/intake/routing';
import { getScreeningReview } from '../../../lib/screening/review';
import { weightCheckFromAnswers } from '../../../lib/intake/weight';

const { user, env } = Astro.locals;
if (!user) return Astro.redirect('/login');

const admin = createAdminClient(env);
const account = await ensureAccount(admin, user.id);
if (account.role !== 'clinician') return Astro.redirect('/');

const { id } = Astro.params;
const ref = id ? await getBookingRefById(admin, id) : null;
if (!ref) return Astro.redirect('/clinician/consults');

const patient = await getAccountById(admin, ref.account_id);
const journey = patient ? await getJourney(admin, patient.id) : null;

// Read the patient's intake from the core (the clinical picture assessed in the
// consult). The booking carries no clinical content; we resolve the intake via
// the patient's latest intake_ref pointer.
const core = getClinicalCore(env, admin);
const intakeRef = patient ? await getLatestIntakeRef(admin, patient.id) : null;
const intake = intakeRef ? await core.getIntake(intakeRef.intake_id) : null;
const answers = (intake?.payload.answers as unknown as IntakeAnswers | undefined) ?? null;
const routing = (intake?.payload.routing as RoutingDecision | undefined) ?? null;

const video = getVideo(env, admin);
const room = ref.room_ref ? await video.getRoom(ref.room_ref) : null;

// Screening (weight lane): the bloods for review + the block signal. Issuing a
// script is blocked until the results are in; refuse stays available. Mirrors the
// guard in decideConsultAction so the console never offers an enabled Issue while
// the decision is blocked.
const screening = getScreening(env, admin);
const review = patient
  ? await getScreeningReview(admin, screening, patient.id)
  : { required: false, status: null, ready: false, blocked: false, panel: null };
const weight = weightCheckFromAnswers(intake?.payload.answers as Record<string, unknown> | undefined);

const error = Astro.url.searchParams.get('error');
const decided = ref.status !== 'booked' || !!ref.decided_at;

const symptomLabel = (symptomId: string) =>
  SYMPTOM_OPTIONS.find((s) => s.id === symptomId)?.label ?? symptomId;
const yesNo = (v: boolean | undefined) => (v ? 'Yes' : 'No');
---

<Layout title="Consult — Fern clinician console" navVariant="clinician" user={user} active="/clinician/consults">
  <div class="wrap detail">
    <p class="back"><a href="/clinician/consults" class="link">&larr; Back to the consult queue</a></p>

    <div class="head stack">
      <span class="eyebrow">Assessed lane &middot; consultation</span>
      <h1>Assessed consultation</h1>
    </div>

    {error && <p class="notice notice-error top-notice">{error}</p>}

    <div class="card meta-card top-notice">
      <dl class="meta">
        <div><dt>Patient (account ref)</dt><dd><code>{ref.account_id.slice(0, 8)}</code></dd></div>
        <div>
          <dt>Slot</dt>
          <dd>{ref.slot_at ? new Date(ref.slot_at).toLocaleString('en-GB') : '(unscheduled)'}</dd>
        </div>
        <div><dt>Booking status</dt><dd><span class="pill pill-soft">{ref.status}</span></dd></div>
        <div><dt>Journey state</dt><dd><span class="pill pill-soft">{journey?.state}</span></dd></div>
      </dl>
    </div>

    <div class="card section room">
      <div class="rx-head">
        <h2>Video room</h2>
        {room && <span class="pill">Room ready</span>}
      </div>
      {
        room ? (
          <>
            <p class="muted">Join the patient in the consultation video room.</p>
            <a href={room.joinUrl} target="_blank" rel="noopener" class="btn btn-pri room-btn">
              Join the consultation room &rarr;
            </a>
          </>
        ) : (
          <p class="notice notice-error">No video room is attached to this booking.</p>
        )
      }
    </div>

    {
      decided && (
        <p class="notice notice-info top-notice">
          This consult has already been decided (<strong>{ref.status}</strong>). Decided at{' '}
          {ref.decided_at ? new Date(ref.decided_at).toLocaleString('en-GB') : 'unknown'}.
        </p>
      )
    }

    <div class="card section">
      <h2>Routing</h2>
      <p class="muted">
        Deterministic outcome: <span class="pill pill-soft">{routing?.outcome ?? 'none'}</span>{' '}
        lane: <span class="pill pill-soft">{routing?.lane ?? 'none'}</span>
      </p>
      {(routing?.reasons ?? []).length > 0 && (
        <ul class="reasons">
          {(routing?.reasons ?? []).map((r) => <li>{r}</li>)}
        </ul>
      )}
    </div>

    <div class="card section">
      <h2>Reported clinical picture</h2>
      {
        answers ? (
          <dl class="picture">
            <div>
              <dt>Treatment history</dt>
              <dd>{answers.treatmentHistory === 'continuing' ? 'Continuing / restarting' : 'First-time initiation'}</dd>
            </div>
            <div>
              <dt>Symptoms</dt>
              <dd>
                {answers.symptoms.length === 0
                  ? '(none reported)'
                  : answers.symptoms.map(symptomLabel).join(', ')}
              </dd>
            </div>
            <div>
              <dt>Months since last period</dt>
              <dd>{answers.monthsSinceLastPeriod ?? '(not given)'}</dd>
            </div>
            <div>
              <dt>Blood pressure (self-reported)</dt>
              <dd>{answers.bpSystolic ?? '?'}/{answers.bpDiastolic ?? '?'} mmHg</dd>
            </div>
            {SCREEN_QUESTIONS.map((q) => (
              <div>
                <dt>{q.label}</dt>
                <dd>{yesNo(answers[q.name] as boolean | undefined)}</dd>
              </div>
            ))}
          </dl>
        ) : (
          <p class="notice notice-error">Could not read the patient's intake from the core.</p>
        )
      }
    </div>

    {
      weight && (
        <div class="card section">
          <h2>Weight / BMI check</h2>
          <dl class="picture">
            <div><dt>BMI (from screening)</dt><dd>{weight.bmi}</dd></div>
            <div><dt>Related health condition</dt><dd>{weight.hasRelatedCondition ? 'Yes' : 'No'}</dd></div>
            <div>
              <dt>Eligibility guide</dt>
              <dd>
                <span class={weight.eligibility.eligible ? 'pill' : 'pill pill-soft'}>
                  {weight.eligibility.eligible ? 'Within guidance' : 'Outside guidance'}
                </span>{' '}
                {weight.eligibility.reason}
              </dd>
            </div>
          </dl>
          <p class="muted decision-copy">Guidance only — a clinician makes the final decision.</p>
        </div>
      )
    }

    {
      review.required && (
        <div class="card section">
          <h2>Screening (bloods)</h2>
          {
            review.ready ? (
              <>
                <p class="muted">At-home blood test results, read from the screening record for review.</p>
                <dl class="picture">
                  {(review.panel ?? []).map((m) => (
                    <div>
                      <dt>{m.marker}</dt>
                      <dd>{m.value ?? '(no value)'} {m.flag && <span class="pill pill-soft">{m.flag}</span>}</dd>
                    </div>
                  ))}
                </dl>
              </>
            ) : (
              <p class="notice notice-soft">
                Bloods pending (<strong>{review.status}</strong>). Issuing a script is blocked until the
                screening results are in. You can still refuse.
              </p>
            )
          }
        </div>
      )
    }

    {
      !decided && (
        <div class="card section decision">
          <h2>Decision</h2>
          <p class="muted decision-copy">
            A clinician makes this decision after the consultation. Issuing the
            script prescribes; nothing is prescribed without this action. Every
            decision records your reason.
          </p>
          <form method="POST" action="/api/clinician/consult-decide" class="stack">
            <input type="hidden" name="bookingRefId" value={ref.id} />

            <label class="field">
              <span class="label">Clinical reason / rationale (recorded with every decision)</span>
              <textarea name="reason" rows="3" required></textarea>
            </label>

            <fieldset class="rx">
              <legend>Script to issue (used only when you issue)</legend>
              <label class="field">
                <span class="label">Medicine</span>
                <input type="text" name="rxName" value="Transdermal HRT (as assessed)" />
              </label>
              <label class="field">
                <span class="label">Directions / dose</span>
                <input type="text" name="rxDose" value="Use as directed" />
              </label>
              <label class="field qty">
                <span class="label">Quantity</span>
                <input type="number" name="rxQuantity" value="1" min="1" />
              </label>
            </fieldset>

            {review.blocked && (
              <p class="notice notice-soft">
                Issuing is disabled until the screening bloods are in. Refuse remains available.
              </p>
            )}

            <div class="actions">
              <button
                type="submit"
                name="action"
                value="issue"
                class="btn btn-pri"
                disabled={review.blocked}
              >
                Issue script
              </button>
              <button type="submit" name="action" value="refuse" class="btn btn-ghost btn-refuse">
                Refuse + signpost
              </button>
            </div>
          </form>
        </div>
      )
    }
  </div>
</Layout>

<style>
  .detail { max-width: 760px; }
  .back { margin-bottom: 18px; }
  .top-notice { margin-top: 22px; }
  .section { margin-top: 22px; }
  .section h2 { font-size: 22px; }

  .meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 18px 22px; margin: 0; }
  .meta dt { font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--soft); }
  .meta dd { margin: 6px 0 0; }

  .rx-head { display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; }
  .room .muted { margin-top: 8px; }
  .room-btn { margin-top: 16px; }

  .reasons { margin: 14px 0 0; padding-left: 20px; }
  .reasons li { color: var(--text); font-size: 15px; }
  .reasons li + li { margin-top: 4px; }

  .picture { margin: 4px 0 0; }
  .picture > div { display: grid; grid-template-columns: 230px 1fr; gap: 16px; padding: 12px 0; border-top: 1px solid var(--border); }
  .picture > div:first-child { border-top: none; }
  .picture dt { font-weight: 600; color: var(--navy); font-size: 14.5px; }
  .picture dd { margin: 0; color: var(--text); }

  .decision-copy { margin: 8px 0 6px; }
  .rx { margin-top: 4px; }
  .rx .field:last-child { margin-bottom: 0; }
  .qty input { max-width: 120px; }

  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 6px; }
  .btn-refuse { color: var(--fern-warn); border-color: rgba(181, 86, 78, 0.45); }
  .btn-refuse:hover { border-color: var(--fern-warn); }

  code { font-family: var(--mono); font-size: 12.5px; }

  @media (max-width: 560px) {
    .picture > div { grid-template-columns: 1fr; gap: 4px; }
    .actions .btn { width: 100%; }
  }
</style>
