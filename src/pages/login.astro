---
import Layout from '../layouts/Layout.astro';
if (Astro.locals.user) return Astro.redirect('/dev/harness');
const error = Astro.url.searchParams.get('error');
---
<Layout title="Log in — Fern" navVariant="public" user={null} narrow>
  <div class="wrap-narrow">
    <div class="stack">
      <span class="eyebrow">Welcome back</span>
      <h1>Log in</h1>
      <p class="lede">Sign in to continue your Fern patient journey.</p>
    </div>

    <form method="POST" action="/api/auth/login" class="card auth-card">
      {error && <p class="notice notice-error">{error}</p>}
      <label class="field">
        <span class="label">Email</span>
        <input type="email" name="email" required autocomplete="email" />
      </label>
      <label class="field">
        <span class="label">Password</span>
        <input type="password" name="password" required autocomplete="current-password" />
      </label>
      <button type="submit" class="btn btn-pri btn-block">Log in</button>
    </form>

    <p class="soft alt">No account? <a href="/signup" class="link">Sign up</a></p>
  </div>
</Layout>

<style>
  .auth-card { margin-top: 28px; }
  .auth-card .field:last-of-type { margin-bottom: 22px; }
  .alt { margin-top: 20px; text-align: center; }
</style>
