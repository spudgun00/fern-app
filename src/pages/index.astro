---
import Layout from '../layouts/Layout.astro';
const { user } = Astro.locals;
---
{
  user ? (
    <Layout title="Fern patient zone" navVariant="patient" user={user} active="/dashboard">
      <div class="wrap-narrow stack-lg">
        <div>
          <span class="eyebrow">Patient zone</span>
          <h1>Welcome back</h1>
          <p class="lede">
            Signed in as {user.email}. Pick up where you left off, or jump
            straight to your care.
          </p>
        </div>
        <div class="card stack">
          <h2>Your care</h2>
          <p class="muted">
            Your dashboard brings together your plan, treatment and next steps.
          </p>
          <div class="row">
            <a href="/dashboard" class="btn btn-pri">Go to dashboard</a>
            <a href="/treatment" class="btn btn-ghost">Your treatment</a>
          </div>
        </div>
        <p class="soft devline">
          Building this demo? The <a href="/dev/harness" class="link">dev harness</a> seeds and
          drives the journeys.
        </p>
      </div>
    </Layout>
  ) : (
    <Layout title="Fern patient zone" navVariant="public" user={null}>
      <div class="wrap-narrow stack-lg">
        <div>
          <span class="eyebrow">Patient zone</span>
          <h1>Menopause care, <em>online</em></h1>
          <p class="lede">
            Clinician-led perimenopause and menopause care. Create an account to
            walk the patient journey, from identity and intake through to a
            clinician decision, your treatment and membership.
          </p>
        </div>
        <div class="row">
          <a href="/signup" class="btn btn-pri">Create your account</a>
          <a href="/login" class="btn btn-ghost">Log in</a>
        </div>
        <p class="soft">
          This is a demonstration on dummy data.
          <a href="/about-this-demo" class="link">About this demo</a>
        </p>
      </div>
    </Layout>
  )
}

<style>
  .row { display: flex; flex-wrap: wrap; gap: 14px; }
  .devline { padding-top: 8px; }
</style>
