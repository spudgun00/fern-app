---
// P3 clinician console — the fast-lane review queue. Role-gated: clinician only.
// The queue is driven by app-DB pointers (queue_item); the clinical content for
// each item (the routing reasons / flags) is read from the core for display and
// never copied app-side. Styled onto the D1 shell (D3); the data fetching and
// role gate are unchanged, only the presentation is new.
import Layout from '../../layouts/Layout.astro';
import { createAdminClient } from '../../lib/supabase/admin';
import { getClinicalCore } from '../../lib/adapters/factory';
import { ensureAccount, listPendingFastQueue } from '../../lib/accounts';
import type { RoutingDecision } from '../../lib/intake/routing';

const { user, env } = Astro.locals;
if (!user) return Astro.redirect('/login');

const admin = createAdminClient(env);
const account = await ensureAccount(admin, user.id);
if (account.role !== 'clinician') return Astro.redirect('/');

const core = getClinicalCore(env, admin);
const items = await listPendingFastQueue(admin);

// For each pending pointer, read the routing reasons from the core for display.
const rows = await Promise.all(
  items.map(async (item) => {
    const intake = await core.getIntake(item.intake_id);
    const routing = (intake?.payload.routing as RoutingDecision | undefined) ?? null;
    return { item, routing, condition: intake?.payload.condition ?? 'unknown' };
  }),
);
---

<Layout title="Review queue — Fern clinician console" navVariant="clinician" user={user} active="/clinician">
  <div class="wrap">
    <div class="head stack">
      <span class="eyebrow">Fast lane</span>
      <h1>Review queue</h1>
      <p class="lede">
        Fast-lane intakes awaiting an async review decision, oldest first. A
        clinician makes every decision; nothing is prescribed automatically.
      </p>
    </div>

    {
      rows.length === 0 ? (
        <div class="card empty">
          <span class="pill pill-soft">Queue empty</span>
          <p class="muted">No fast-lane intakes are awaiting review.</p>
        </div>
      ) : (
        <ul class="queue">
          {rows.map(({ item, routing, condition }) => (
            <li>
              <a href={`/clinician/intake/${item.id}`} class="qrow card">
                <div class="qmain">
                  <div class="qtop">
                    <span class="qcond">{condition}</span>
                    <span class="pill pill-soft qref">{item.account_id.slice(0, 8)}</span>
                  </div>
                  <div class="qmeta">
                    Submitted {new Date(item.created_at).toLocaleString('en-GB')}
                  </div>
                  {(routing?.reasons ?? []).length > 0 && (
                    <div class="qflags">
                      {(routing?.reasons ?? []).map((r) => (
                        <span class="pill pill-soft">{r}</span>
                      ))}
                    </div>
                  )}
                </div>
                <span class="qgo" aria-hidden="true">Review &rarr;</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Layout>

<style>
  .head { max-width: 64ch; }
  .empty { margin-top: 28px; }
  .empty .muted { margin-top: 10px; }

  .queue { list-style: none; margin: 28px 0 0; padding: 0; }
  .queue li + li { margin-top: 14px; }
  .qrow {
    display: flex; align-items: center; justify-content: space-between;
    gap: 18px; padding: 20px 24px; text-decoration: none;
    transition: border-color var(--dur-quick, 0.2s) ease, box-shadow var(--dur-quick, 0.2s) ease, transform var(--dur-quick, 0.2s) ease;
  }
  .qrow:hover { border-color: var(--border-d); transform: translateY(-1px); }
  .qmain { min-width: 0; }
  .qtop { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .qcond {
    font-family: var(--disp); font-size: 19px; font-weight: 600; color: var(--navy);
    text-transform: capitalize;
  }
  .qref { font-size: 10.5px; }
  .qmeta { font-size: 13.5px; color: var(--soft); margin-top: 6px; }
  .qflags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
  .qgo {
    flex: none; font-family: var(--body); font-weight: 600; font-size: 15px;
    color: var(--navy); white-space: nowrap;
  }

  @media (max-width: 560px) {
    .qrow { flex-direction: column; align-items: flex-start; gap: 14px; }
  }
</style>
