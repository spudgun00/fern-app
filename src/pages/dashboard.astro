---
import Layout from '../layouts/Layout.astro';
import Coming from '../components/Coming.astro';
const { user } = Astro.locals;
if (!user) return Astro.redirect('/login');
---
<Layout title="Dashboard — Fern" navVariant="patient" user={user} active="/dashboard">
  <Coming
    eyebrow="Your home"
    title="Your dashboard"
    blurb="The single view of your care: your plan, your next review, recent messages and prescriptions at a glance."
  />
</Layout>
