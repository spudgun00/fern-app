---
// In-app stand-in for the provider's hosted checkout, used only when
// PAYMENTS_IMPL=mock. It plays the role of Stripe's hosted Checkout page: the
// user "pays" here. No card details are entered or stored; this is a dev
// affordance. The real Stripe test-mode checkout replaces this page entirely.
// Styled onto the D1 shell (D2), clearly fenced as a demo stand-in.
import Layout from '../../../layouts/Layout.astro';
const { user } = Astro.locals;
if (!user) return Astro.redirect('/login');

const session = Astro.url.searchParams.get('session') ?? '';
const kind = Astro.url.searchParams.get('kind') ?? 'consult';
const ret = Astro.url.searchParams.get('return') ?? '/account/billing/complete';

// The line label per checkout kind. 'treatment' (the pay-first one-off, C2) is
// kept POM-safe and neutral here — this stand-in does not know the product
// descriptor, and no medicine name ever appears in a checkout line.
const label =
  kind === 'membership'
    ? 'Membership (£18/mo)'
    : kind === 'treatment'
      ? 'Your Fern programme (includes your health screen)'
      : 'Consultation fee (£100)';
---

<Layout title="Checkout — Fern" navVariant="patient" user={user} narrow>
  <div class="wrap-narrow">
    <div class="stack">
      <span class="pill pill-soft">Demo stand-in</span>
      <h1>Checkout</h1>
      <p class="lede">
        This stands in for the hosted checkout page. No card details are entered
        or stored. The live payment uses the provider's secure checkout.
      </p>
    </div>

    <form method="POST" action="/api/payments/mock-confirm" class="card checkout-card">
      <input type="hidden" name="session" value={session} />
      <input type="hidden" name="return" value={ret} />
      <div class="line">
        <span class="line-label">You are paying for</span>
        <span class="line-amt">{label}</span>
      </div>
      <button type="submit" class="btn btn-pri btn-block pay">Complete payment</button>
    </form>

    <p class="soft alt"><a href="/account/billing" class="link">Cancel and go back</a></p>
  </div>
</Layout>

<style>
  .checkout-card { margin-top: 26px; }
  .line {
    display: flex; align-items: center; justify-content: space-between;
    gap: 14px; padding-bottom: 18px; margin-bottom: 4px;
    border-bottom: 1px solid var(--border);
  }
  .line-label { color: var(--muted); font-size: 14.5px; }
  .line-amt { font-family: var(--disp); font-size: 18px; font-weight: 600; color: var(--navy); }
  .pay { margin-top: 18px; }
  .alt { margin-top: 18px; text-align: center; }
</style>
