---
// P3 clinician console — intake detail + the decision action bar. Role-gated.
// Reads the pre-filled clinical screen from the core (reading clinical content
// server-side for display is allowed; it is never copied app-side). The action
// bar posts to /api/clinician/decide: Approve + issue script | Escalate to
// consult | Refuse + signpost. Every action requires a recorded reason.
import { createAdminClient } from '../../../lib/supabase/admin';
import { getClinicalCore } from '../../../lib/adapters/factory';
import { ensureAccount, getQueueItemById, getJourney } from '../../../lib/accounts';
import { SYMPTOM_OPTIONS, SCREEN_QUESTIONS } from '../../../lib/intake/questionnaire';
import type { IntakeAnswers, RoutingDecision } from '../../../lib/intake/routing';

const { user, env } = Astro.locals;
if (!user) return Astro.redirect('/login');

const admin = createAdminClient(env);
const account = await ensureAccount(admin, user.id);
if (account.role !== 'clinician') return Astro.redirect('/');

const { id } = Astro.params;
const item = id ? await getQueueItemById(admin, id) : null;
if (!item) return Astro.redirect('/clinician');

const core = getClinicalCore(env, admin);
const intake = await core.getIntake(item.intake_id);
const answers = (intake?.payload.answers as unknown as IntakeAnswers | undefined) ?? null;
const routing = (intake?.payload.routing as RoutingDecision | undefined) ?? null;
const journey = await getJourney(admin, item.account_id);

const error = Astro.url.searchParams.get('error');
const decided = item.status !== 'pending';

const symptomLabel = (symptomId: string) =>
  SYMPTOM_OPTIONS.find((s) => s.id === symptomId)?.label ?? symptomId;
const yesNo = (v: boolean | undefined) => (v ? 'Yes' : 'No');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Intake review &mdash; Fern clinician console</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>
  <body>
    <p><a href="/clinician">&larr; Back to the queue</a></p>
    <h1>Intake review</h1>
    <p>Signed in as {user.email} (clinician). <a href="/logout">Log out</a></p>
    {error && <p style="color: #b00">{error}</p>}

    <p>
      Patient (core ref): <code>{item.account_id.slice(0, 8)}</code> &middot; lane:{' '}
      <code>{item.lane}</code> &middot; queue status: <code>{item.status}</code> &middot; journey
      state: <code>{journey?.state}</code>
    </p>

    {
      decided && (
        <p style="color: #060">
          This intake has already been decided (<code>{item.status}</code>). Decided at{' '}
          {item.decided_at ? new Date(item.decided_at).toLocaleString('en-GB') : 'unknown'}.
        </p>
      )
    }

    <h2>Routing</h2>
    <p>
      Deterministic outcome: <code>{routing?.outcome}</code> &middot; lane:{' '}
      <code>{routing?.lane ?? '(none)'}</code>
    </p>
    <ul>
      {(routing?.reasons ?? []).map((r) => <li>{r}</li>)}
    </ul>

    <h2>Reported clinical picture</h2>
    {
      answers ? (
        <dl>
          <dt>Treatment history</dt>
          <dd>{answers.treatmentHistory === 'continuing' ? 'Continuing / restarting' : 'First-time initiation'}</dd>

          <dt>Symptoms</dt>
          <dd>
            {answers.symptoms.length === 0
              ? '(none reported)'
              : answers.symptoms.map(symptomLabel).join(', ')}
          </dd>

          <dt>Months since last period</dt>
          <dd>{answers.monthsSinceLastPeriod ?? '(not given)'}</dd>

          <dt>Blood pressure (self-reported)</dt>
          <dd>
            {answers.bpSystolic ?? '?'}/{answers.bpDiastolic ?? '?'} mmHg
          </dd>

          {SCREEN_QUESTIONS.map((q) => (
            <>
              <dt>{q.label}</dt>
              <dd>{yesNo(answers[q.name] as boolean | undefined)}</dd>
            </>
          ))}
        </dl>
      ) : (
        <p style="color: #b00">Could not read the intake from the core.</p>
      )
    }

    {
      !decided && (
        <>
          <h2>Decision</h2>
          <p>
            A clinician makes this decision. Approving issues the script; nothing is prescribed
            without this action. Every decision records your reason.
          </p>
          <form method="POST" action="/api/clinician/decide">
            <input type="hidden" name="queueItemId" value={item.id} />

            <p>
              <label>
                Clinical reason / rationale (recorded with every decision)
                <br />
                <textarea name="reason" rows="3" cols="60" required />
              </label>
            </p>

            <fieldset>
              <legend>Script to issue (used only when you approve)</legend>
              <p>
                <label>
                  Medicine
                  <br />
                  <input type="text" name="rxName" value="Transdermal HRT (as assessed)" size="40" />
                </label>
              </p>
              <p>
                <label>
                  Directions / dose
                  <br />
                  <input type="text" name="rxDose" value="Use as directed" size="40" />
                </label>
              </p>
              <p>
                <label>
                  Quantity
                  <br />
                  <input type="number" name="rxQuantity" value="1" min="1" />
                </label>
              </p>
            </fieldset>

            <p>
              <button type="submit" name="action" value="approve">
                Approve + issue script
              </button>{' '}
              <button type="submit" name="action" value="escalate">
                Escalate to consult
              </button>{' '}
              <button type="submit" name="action" value="refuse">
                Refuse + signpost
              </button>
            </p>
          </form>
        </>
      )
    }
  </body>
</html>
