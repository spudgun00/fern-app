---
// P1 profile capture. Collects demographic identity (sent to the clinical core,
// not the app DB) and the GP info-sharing decision. Styled onto the D1 shell;
// all logic + the form action are unchanged.
import Layout from '../../layouts/Layout.astro';
import { createAdminClient } from '../../lib/supabase/admin';
import { ensureAccount, getGpSharing, getJourney } from '../../lib/accounts';

const { user, env } = Astro.locals;
if (!user) return Astro.redirect('/login');

const admin = createAdminClient(env);
const account = await ensureAccount(admin, user.id);
const journey = await getJourney(admin, account.id);

// Already past ID? Send the user on rather than back to the start of onboarding.
if (journey && journey.state !== 'registered') return Astro.redirect('/account/verify');

const existingGp = await getGpSharing(admin, account.id);
const error = Astro.url.searchParams.get('error');
---
<Layout title="Your profile — Fern" navVariant="onboarding" user={user} narrow step={1}>
  <div class="wrap-narrow">
    <div class="stack">
      <span class="steps">Step 1 of 2 &middot; Profile</span>
      <h1>Your profile</h1>
      <p class="lede">A few details about you and your GP, before we verify your identity.</p>
    </div>

    <form method="POST" action="/api/account/profile" class="auth-card">
      {error && <p class="notice notice-error">{error}</p>}

      <div class="card stack">
        <h2>About you</h2>
        <label class="field">
          <span class="label">Full name</span>
          <input type="text" name="fullName" required autocomplete="name" />
        </label>
        <label class="field">
          <span class="label">Date of birth</span>
          <input type="date" name="dateOfBirth" required />
        </label>
        <label class="field">
          <span class="label">Contact phone</span>
          <input type="tel" name="contact" required autocomplete="tel" />
        </label>
      </div>

      <div class="card stack">
        <h2>Your GP</h2>
        <label class="field">
          <span class="label">GP name or practice</span>
          <input type="text" name="gpPractice" />
        </label>

        <fieldset>
          <legend>Sharing information with your GP</legend>
          <label class="choice">
            <input type="radio" name="gpDecision" value="consent" required />
            <span>I consent to Fern sharing relevant information with my GP</span>
          </label>
          <label class="choice">
            <input type="radio" name="gpDecision" value="refused" />
            <span>I do not consent (a recorded risk note is required)</span>
          </label>
        </fieldset>

        <label class="field">
          <span class="label">Risk note</span>
          <textarea name="riskNote" rows="3"></textarea>
          <span class="hint">Required if you do not consent to GP sharing.</span>
        </label>
      </div>

      <button type="submit" class="btn btn-pri btn-block submit">Save and continue to ID check</button>

      {existingGp && (
        <p class="soft prev">
          Previously recorded GP-sharing decision: <code>{existingGp.decision}</code>
        </p>
      )}
    </form>
  </div>
</Layout>

<style>
  .auth-card { margin-top: 28px; }
  .submit { margin-top: 24px; }
  .prev { margin-top: 16px; text-align: center; }
  code { font-family: var(--mono); font-size: 13px; }
</style>
