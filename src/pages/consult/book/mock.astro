---
// In-app stand-in for the provider's hosted booking page, used only when
// BOOKING_IMPL=mock. It plays the role of Cal.com's hosted scheduler: the user
// picks a slot here. No attendee details are entered or stored; this is a dev
// affordance. The real Cal.com test-mode scheduler replaces this page entirely.
// Styled onto the D1 shell (D2), clearly fenced as a demo stand-in.
import Layout from '../../../layouts/Layout.astro';
const { user } = Astro.locals;
if (!user) return Astro.redirect('/login');

const booking = Astro.url.searchParams.get('booking') ?? '';
const ret = Astro.url.searchParams.get('return') ?? '/consult/book/complete';

// Offer a few near-future slots (whole hours over the next two days). The chosen
// ISO time is posted to the confirm route, which marks the mock booking booked.
const now = new Date();
const slots: string[] = [];
for (let day = 1; day <= 2; day++) {
  for (const hour of [9, 11, 14]) {
    const d = new Date(now);
    d.setDate(d.getDate() + day);
    d.setHours(hour, 0, 0, 0);
    slots.push(d.toISOString());
  }
}
---

<Layout title="Choose a slot — Fern" navVariant="patient" user={user} narrow step={5}>
  <div class="wrap-narrow">
    <div class="stack">
      <span class="pill pill-soft">Demo stand-in</span>
      <h1>Choose a consultation slot</h1>
      <p class="lede">
        This stands in for the scheduling page. No attendee details are entered or
        stored. The live booking uses the provider's hosted scheduler.
      </p>
    </div>

    <form method="POST" action="/api/consult/book/mock-confirm" class="book-form">
      <input type="hidden" name="booking" value={booking} />
      <input type="hidden" name="return" value={ret} />
      <fieldset class="card slot-card">
        <legend>Available slots</legend>
        {
          slots.map((iso, i) => (
            <label class="choice slot">
              <input type="radio" name="slot" value={iso} required={i === 0} checked={i === 0} />
              <span>{new Date(iso).toLocaleString('en-GB')}</span>
            </label>
          ))
        }
      </fieldset>
      <button type="submit" class="btn btn-pri btn-block submit">Confirm booking</button>
    </form>

    <p class="soft alt"><a href="/consult" class="link">Cancel and go back</a></p>
  </div>
</Layout>

<style>
  .book-form { margin-top: 26px; }
  .slot-card legend {
    font-family: var(--disp); font-size: 18px; font-weight: 600;
    color: var(--navy); padding: 0; margin-bottom: 8px;
  }
  .slot { padding: 12px 0; border-top: 1px solid var(--border); font-size: 15.5px; }
  .slot:first-of-type { border-top: none; }
  .submit { margin-top: 22px; }
  .alt { margin-top: 18px; text-align: center; }
</style>
