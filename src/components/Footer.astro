---
import Wordmark from './Wordmark.astro';
// App footer. Adapted from the marketing Footer pattern, but its link columns
// point at the marketing site (fern.care) and the demo's own pages — the app
// has no legal/marketing routes of its own. Carries the care disclaimer and the
// demo status, in keeping with the sitewide banner.
const year = new Date().getFullYear();
---
<footer class="appfoot">
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <div class="foot-logo"><Wordmark dot="lime" size="27px" /></div>
        <p class="disclaimer">
          This is a demonstration of the Fern patient zone on dummy data. It is
          not live care and there are no real patients. Fern provides care once
          registered to do so. If you need urgent help, contact your GP or NHS 111.
        </p>
      </div>
      <nav class="fcol" aria-label="This demo">
        <div class="fh">This demo</div>
        <a href="/about-this-demo">About this demo</a>
        <a href="https://fern.care">fern.care</a>
      </nav>
      <nav class="fcol" aria-label="Urgent help">
        <div class="fh">Urgent help</div>
        <span class="ftext">Your GP</span>
        <span class="ftext">NHS 111</span>
        <span class="ftext">999 in an emergency</span>
      </nav>
    </div>
    <div class="foot-base">© {year} Fern. Demonstration build. Not yet operating.</div>
  </div>
</footer>

<style>
  .appfoot { background: var(--navy-deep); color: var(--inv); margin-top: 40px; }
  .appfoot .wrap { padding-top: 52px; padding-bottom: 38px; }
  .foot-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 28px;
  }
  @media (max-width: 680px) { .foot-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 420px) { .foot-grid { grid-template-columns: 1fr; } }
  .foot-logo { font-size: 27px; }
  .disclaimer {
    font-family: var(--mono);
    font-size: 10.5px;
    line-height: 1.7;
    color: var(--inv-faint);
    max-width: 46ch;
    margin-top: 14px;
  }
  .fcol .fh {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--inv-faint);
    margin-bottom: 14px;
  }
  .fcol a, .fcol .ftext {
    display: block;
    font-size: 13.5px;
    color: var(--inv-muted);
    text-decoration: none;
    margin: 8px 0;
  }
  .fcol a:hover { color: #fff; }
  .foot-base {
    margin-top: 38px;
    padding-top: 20px;
    border-top: 1px solid var(--border-d);
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--inv-faint);
    letter-spacing: 0.04em;
  }
</style>
