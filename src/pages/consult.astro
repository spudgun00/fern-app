---
// P6 patient consult surface (the full / assessed lane). Branches on the journey
// state: gate on the consult fee, then book a slot, then join the video room at
// the slot. After the clinician's decision it points on to treatment, or shows
// the refusal signpost. Styled onto the D1 shell (D2); branching logic + the
// form actions are unchanged.
//
// Describe-never-diagnose: copy states the next step plainly, never a diagnosis.
import Layout from '../layouts/Layout.astro';
import { createAdminClient } from '../lib/supabase/admin';
import { getBooking, getVideo } from '../lib/adapters/factory';
import { ensureAccount } from '../lib/accounts';
import { getConsultView } from '../lib/consult/booking';

const { user, env } = Astro.locals;
if (!user) return Astro.redirect('/login');

const admin = createAdminClient(env);
const account = await ensureAccount(admin, user.id);
if (account.role === 'clinician') return Astro.redirect('/clinician');
if (!account.core_patient_id) return Astro.redirect('/account/profile');

const booking = getBooking(env, admin);
const video = getVideo(env, admin);
const view = await getConsultView(admin, booking, video, account.id);

const error = Astro.url.searchParams.get('error');
const state = view.state;
const inRoom = state === 'consult_booked' || state === 'consult_done';
const pendingBooking = view.booking?.status === 'pending';
const afterConsult =
  state === 'rx_issued' || state === 'dispensing' || state === 'delivered' || state === 'active_member';
---

<Layout title="Your consultation — Fern" navVariant="patient" user={user} narrow>
  <div class="wrap-narrow">
    <div class="stack">
      <span class="eyebrow">Assessed consultation</span>
      <h1>Your consultation</h1>
    </div>

    {error && <p class="notice notice-error top-notice">{error}</p>}

    {
      afterConsult ? (
        <div class="card step-card stack">
          <span class="pill">Consultation complete</span>
          <p>
            Your consultation is complete and a clinician has issued your
            prescription.
          </p>
          <a href="/treatment" class="btn btn-pri">View your treatment and dispensing status</a>
        </div>
      ) : state === 'refused' ? (
        <div class="card step-card stack">
          <span class="pill pill-warn">Cannot continue here</span>
          <p>
            A clinician has reviewed your consultation and we cannot continue your
            request here. Please speak to your GP, or call NHS 111 if you need
            advice sooner.
          </p>
        </div>
      ) : inRoom ? (
        <div class="card step-card stack">
          <span class="pill">Consultation booked</span>
          <h2>Your consult room</h2>
          {view.slotAt && (
            <p class="appt">
              Your appointment:{' '}
              <strong>{new Date(view.slotAt).toLocaleString('en-GB')}</strong>.
            </p>
          )}
          <p class="muted">
            Join the video room at your appointment time. A clinician will join the
            same room, review your intake with you, and decide the next step.
          </p>
          {view.joinUrl ? (
            <a href={view.joinUrl} target="_blank" rel="noopener" class="btn btn-pri">
              Join the video consultation
            </a>
          ) : (
            <p class="notice notice-soft">The room is being set up. Reload in a moment.</p>
          )}
        </div>
      ) : !view.consultPaid ? (
        <div class="card step-card stack">
          <span class="pill pill-soft">Step 1 &middot; Consultation fee</span>
          <h2>Pay for your consultation</h2>
          <p class="muted">
            An assessed first prescription follows a consultation with a clinician.
            Pay the consultation fee, then book your slot.
          </p>
          <a href="/account/billing" class="btn btn-pri">Go to billing to pay the consultation fee</a>
        </div>
      ) : pendingBooking ? (
        <div class="card step-card stack">
          <span class="pill pill-soft">Booking in progress</span>
          <h2>Booking in progress</h2>
          <p class="muted">Your booking is being confirmed.</p>
          <a href="/consult/book/complete" class="link">Refresh booking status</a>
        </div>
      ) : view.canBook ? (
        <div class="card step-card stack">
          <span class="pill pill-soft">Step 2 &middot; Book a slot</span>
          <h2>Book your consultation</h2>
          <p class="muted">
            Your consultation fee is paid. Choose a slot with a clinician. The
            consultation is by video; nothing is prescribed without it.
          </p>
          <form method="POST" action="/api/consult/book/start">
            <button type="submit" class="btn btn-pri">Book your consult</button>
          </form>
        </div>
      ) : (
        <div class="card step-card stack">
          <p class="muted">
            The assessed consultation becomes available once your intake routes you
            to the full lane.
          </p>
          <a href="/intake" class="link">Go to intake</a>
        </div>
      )
    }

    <p class="soft devline">
      <span class="dev-tag">Demo detail</span>
      state <code>{state ?? 'none'}</code>
    </p>
  </div>
</Layout>

<style>
  .top-notice { margin-top: 22px; }
  .step-card { margin-top: 24px; }
  .step-card h2 { font-size: 22px; }
  .step-card .btn { align-self: flex-start; }
  .appt { font-size: 16px; }
  .devline { margin-top: 22px; font-size: 12.5px; }
  .dev-tag {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
    margin-right: 8px;
  }
  code { font-family: var(--mono); font-size: 12.5px; }
</style>
