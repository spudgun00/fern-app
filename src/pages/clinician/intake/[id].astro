---
// P3 clinician console — intake detail + the decision action bar. Role-gated.
// Reads the pre-filled clinical screen from the core (reading clinical content
// server-side for display is allowed; it is never copied app-side). The action
// bar posts to /api/clinician/decide: Approve + issue script | Escalate to
// consult | Refuse + signpost. Every action requires a recorded reason. Styled
// onto the D1 shell (D3); the decision logic + form actions are unchanged.
import Layout from '../../../layouts/Layout.astro';
import { createAdminClient } from '../../../lib/supabase/admin';
import { getClinicalCore, getScreening } from '../../../lib/adapters/factory';
import { ensureAccount, getQueueItemById, getJourney } from '../../../lib/accounts';
import { SYMPTOM_OPTIONS, SCREEN_QUESTIONS } from '../../../lib/intake/questionnaire';
import type { IntakeAnswers, RoutingDecision } from '../../../lib/intake/routing';
import { getScreeningReview } from '../../../lib/screening/review';
import { weightCheckFromAnswers } from '../../../lib/intake/weight';

const { user, env } = Astro.locals;
if (!user) return Astro.redirect('/login');

const admin = createAdminClient(env);
const account = await ensureAccount(admin, user.id);
if (account.role !== 'clinician') return Astro.redirect('/');

const { id } = Astro.params;
const item = id ? await getQueueItemById(admin, id) : null;
if (!item) return Astro.redirect('/clinician');

const core = getClinicalCore(env, admin);
const intake = await core.getIntake(item.intake_id);
const answers = (intake?.payload.answers as unknown as IntakeAnswers | undefined) ?? null;
const routing = (intake?.payload.routing as RoutingDecision | undefined) ?? null;
const journey = await getJourney(admin, item.account_id);

// Screening (weight lane): the bloods for review + the block signal. Reads the
// panel from the ScreeningAdapter ONLY when results are in; mirrors the guard so
// the console never offers an enabled Approve while the decision is blocked.
const screening = getScreening(env, admin);
const review = await getScreeningReview(admin, screening, item.account_id);
const weight = weightCheckFromAnswers(intake?.payload.answers as Record<string, unknown> | undefined);

const error = Astro.url.searchParams.get('error');
const decided = item.status !== 'pending';

// Phase F — the demo-only "auto-approve after 10s" convenience (env-gated, off by
// default). It only offers when Approve itself is available (not decided, not
// blocked by the screening guard). It is a UI timer over the SAME Approve action a
// clinician clicks; the hard line is untouched.
const autoApprove = env.DEMO_AUTO_APPROVE && !decided && !review.blocked;

const symptomLabel = (symptomId: string) =>
  SYMPTOM_OPTIONS.find((s) => s.id === symptomId)?.label ?? symptomId;
const yesNo = (v: boolean | undefined) => (v ? 'Yes' : 'No');
---

<Layout title="Intake review — Fern clinician console" navVariant="clinician" user={user} active="/clinician">
  <div class="wrap detail">
    <p class="back"><a href="/clinician" class="link">&larr; Back to the queue</a></p>

    <div class="head stack">
      <span class="eyebrow">Fast lane &middot; intake review</span>
      <h1>Intake review</h1>
    </div>

    {error && <p class="notice notice-error top-notice">{error}</p>}

    <div class="card meta-card top-notice">
      <dl class="meta">
        <div><dt>Patient (core ref)</dt><dd><code>{item.account_id.slice(0, 8)}</code></dd></div>
        <div><dt>Lane</dt><dd><span class="pill pill-soft">{item.lane}</span></dd></div>
        <div><dt>Queue status</dt><dd><span class="pill pill-soft">{item.status}</span></dd></div>
        <div><dt>Journey state</dt><dd><span class="pill pill-soft">{journey?.state}</span></dd></div>
      </dl>
    </div>

    {
      decided && (
        <p class="notice notice-info top-notice">
          This intake has already been decided (<strong>{item.status}</strong>). Decided at{' '}
          {item.decided_at ? new Date(item.decided_at).toLocaleString('en-GB') : 'unknown'}.
        </p>
      )
    }

    <div class="card section">
      <h2>Routing</h2>
      <p class="muted">
        Deterministic outcome: <span class="pill pill-soft">{routing?.outcome}</span>{' '}
        lane: <span class="pill pill-soft">{routing?.lane ?? 'none'}</span>
      </p>
      {(routing?.reasons ?? []).length > 0 && (
        <ul class="reasons">
          {(routing?.reasons ?? []).map((r) => <li>{r}</li>)}
        </ul>
      )}
    </div>

    <div class="card section">
      <h2>Reported clinical picture</h2>
      {
        answers ? (
          <dl class="picture">
            <div>
              <dt>Treatment history</dt>
              <dd>{answers.treatmentHistory === 'continuing' ? 'Continuing / restarting' : 'First-time initiation'}</dd>
            </div>
            <div>
              <dt>Symptoms</dt>
              <dd>
                {answers.symptoms.length === 0
                  ? '(none reported)'
                  : answers.symptoms.map(symptomLabel).join(', ')}
              </dd>
            </div>
            <div>
              <dt>Months since last period</dt>
              <dd>{answers.monthsSinceLastPeriod ?? '(not given)'}</dd>
            </div>
            <div>
              <dt>Blood pressure (self-reported)</dt>
              <dd>{answers.bpSystolic ?? '?'}/{answers.bpDiastolic ?? '?'} mmHg</dd>
            </div>
            {SCREEN_QUESTIONS.map((q) => (
              <div>
                <dt>{q.label}</dt>
                <dd>{yesNo(answers[q.name] as boolean | undefined)}</dd>
              </div>
            ))}
          </dl>
        ) : (
          <p class="notice notice-error">Could not read the intake from the core.</p>
        )
      }
    </div>

    {
      weight && (
        <div class="card section">
          <h2>Weight / BMI check</h2>
          <dl class="picture">
            <div><dt>BMI (from screening)</dt><dd>{weight.bmi}</dd></div>
            <div><dt>Related health condition</dt><dd>{weight.hasRelatedCondition ? 'Yes' : 'No'}</dd></div>
            <div>
              <dt>Eligibility guide</dt>
              <dd>
                <span class={weight.eligibility.eligible ? 'pill' : 'pill pill-soft'}>
                  {weight.eligibility.eligible ? 'Within guidance' : 'Outside guidance'}
                </span>{' '}
                {weight.eligibility.reason}
              </dd>
            </div>
          </dl>
          <p class="muted decision-copy">Guidance only — a clinician makes the final decision.</p>
        </div>
      )
    }

    {
      review.required && (
        <div class="card section">
          <h2>Screening (bloods)</h2>
          {
            review.ready ? (
              <>
                <p class="muted">At-home blood test results, read from the screening record for review.</p>
                <dl class="picture">
                  {(review.panel ?? []).map((m) => (
                    <div>
                      <dt>{m.marker}</dt>
                      <dd>{m.value ?? '(no value)'} {m.flag && <span class="pill pill-soft">{m.flag}</span>}</dd>
                    </div>
                  ))}
                </dl>
              </>
            ) : (
              <p class="notice notice-soft">
                Bloods pending (<strong>{review.status}</strong>). A prescribing decision is blocked
                until the screening results are in. You can still escalate or refuse.
              </p>
            )
          }
        </div>
      )
    }

    {
      !decided && (
        <div class="card section decision">
          <h2>Decision</h2>
          <p class="muted decision-copy">
            A clinician makes this decision. Approving issues the script; nothing
            is prescribed without this action. Every decision records your reason.
          </p>

          {autoApprove && (
            <div class="notice notice-info auto-approve" id="auto-approve">
              <div class="aa-row">
                <span class="pill">Demo auto-approve</span>
                <span class="aa-text">
                  Approving as the clinician in <strong id="aa-count">10</strong>s. This
                  runs the same Approve action a clinician clicks; it does not bypass the
                  clinician decision.
                </span>
              </div>
              <button type="button" class="btn btn-ghost aa-cancel" id="aa-cancel">
                Cancel auto-approve
              </button>
            </div>
          )}

          <form method="POST" action="/api/clinician/decide" class="stack" id="decide-form">
            <input type="hidden" name="queueItemId" value={item.id} />

            <label class="field">
              <span class="label">Clinical reason / rationale (recorded with every decision)</span>
              <textarea name="reason" rows="3" required></textarea>
            </label>

            <fieldset class="rx">
              <legend>Script to issue (used only when you approve)</legend>
              <label class="field">
                <span class="label">Medicine</span>
                <input type="text" name="rxName" value="Transdermal HRT (as assessed)" />
              </label>
              <label class="field">
                <span class="label">Directions / dose</span>
                <input type="text" name="rxDose" value="Use as directed" />
              </label>
              <label class="field qty">
                <span class="label">Quantity</span>
                <input type="number" name="rxQuantity" value="1" min="1" />
              </label>
            </fieldset>

            {review.blocked && (
              <p class="notice notice-soft">
                Approving is disabled until the screening bloods are in. Escalate or refuse remain available.
              </p>
            )}

            <div class="actions">
              <button
                type="submit"
                name="action"
                value="approve"
                class="btn btn-pri"
                id="approve-btn"
                disabled={review.blocked}
              >
                Approve + issue script
              </button>
              <button type="submit" name="action" value="escalate" class="btn btn-ghost">
                Escalate to consult
              </button>
              <button type="submit" name="action" value="refuse" class="btn btn-ghost btn-refuse">
                Refuse + signpost
              </button>
            </div>
          </form>
        </div>
      )
    }
  </div>

  {
    autoApprove && (
      <script is:inline>
        // Phase F demo convenience: after a 10s countdown, submit the SAME clinician
        // Approve. A recorded reason is required, so prefill one if the clinician has
        // not typed their own. Cancel stops the timer. This is a UI timer over the
        // existing form; the server still runs the full clinician-decision hard line.
        (() => {
          const banner = document.getElementById('auto-approve');
          const countEl = document.getElementById('aa-count');
          const cancelBtn = document.getElementById('aa-cancel');
          const approveBtn = document.getElementById('approve-btn');
          const reason = document.querySelector('#decide-form [name="reason"]');
          if (!banner || !countEl || !cancelBtn || !approveBtn) return;
          let left = 10;
          const tick = setInterval(() => {
            left -= 1;
            countEl.textContent = String(Math.max(left, 0));
            if (left <= 0) {
              clearInterval(tick);
              if (reason && !reason.value.trim()) {
                reason.value =
                  'Auto-approved in the demo walk-through: clear continuing picture, no contraindications.';
              }
              approveBtn.click();
            }
          }, 1000);
          cancelBtn.addEventListener('click', () => {
            clearInterval(tick);
            banner.remove();
          });
        })();
      </script>
    )
  }
</Layout>

<style>
  .detail { max-width: 760px; }
  .back { margin-bottom: 18px; }
  .top-notice { margin-top: 22px; }
  .section { margin-top: 22px; }
  .section h2 { font-size: 22px; }

  .meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 18px 22px; margin: 0; }
  .meta dt { font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--soft); }
  .meta dd { margin: 6px 0 0; }

  .reasons { margin: 14px 0 0; padding-left: 20px; }
  .reasons li { color: var(--text); font-size: 15px; }
  .reasons li + li { margin-top: 4px; }

  .picture { margin: 4px 0 0; }
  .picture > div { display: grid; grid-template-columns: 230px 1fr; gap: 16px; padding: 12px 0; border-top: 1px solid var(--border); }
  .picture > div:first-child { border-top: none; }
  .picture dt { font-weight: 600; color: var(--navy); font-size: 14.5px; }
  .picture dd { margin: 0; color: var(--text); }

  .decision-copy { margin: 8px 0 6px; }

  .auto-approve { margin: 6px 0 18px; display: flex; flex-direction: column; gap: 12px; }
  .auto-approve .aa-row { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .auto-approve .aa-text { font-size: 14.5px; }
  .auto-approve .aa-cancel { align-self: flex-start; }
  .rx { margin-top: 4px; }
  .rx .field:last-child { margin-bottom: 0; }
  .qty input { max-width: 120px; }

  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 6px; }
  .btn-refuse { color: var(--fern-warn); border-color: rgba(181, 86, 78, 0.45); }
  .btn-refuse:hover { border-color: var(--fern-warn); }

  code { font-family: var(--mono); font-size: 12.5px; }

  @media (max-width: 560px) {
    .picture > div { grid-template-columns: 1fr; gap: 4px; }
    .actions .btn { width: 100%; }
  }
</style>
