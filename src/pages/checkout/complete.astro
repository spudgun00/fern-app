---
// Checkout C2 — the return page from the payment provider (and the mock checkout).
// Finalises the in-flight treatment checkout (marks the pending session paid by
// reading the live provider status) and runs THE GATE: a paid treatment payment
// advances intake_submitted -> screening_kit_sent (orders the shared screening
// kit). For Stripe the webhook is authoritative; this poll is idempotent with it.
//
// HARD LINE: the gate advances to the screening branch ONLY — never a decision
// state, never a script. A clinician still decides once the bloods are in.
import Layout from '../../layouts/Layout.astro';
import { createAdminClient } from '../../lib/supabase/admin';
import { getClinicalCore, getDispensing, getEmail, getPayments, getScreening } from '../../lib/adapters/factory';
import { ensureAccount, getJourney, hasPaidConsult } from '../../lib/accounts';
import { flagsFromEnv } from '../../lib/cta';
import { finaliseTreatmentCheckout } from '../../lib/checkout/checkout';
import { finaliseLatestPending } from '../../lib/payments/billing';
import { finaliseMedicationCheckout, medicationBillingFromEnv } from '../../lib/medication/medication';
import { finaliseAddonCheckout, type AddonKind } from '../../lib/addons/addons';
import { finaliseBasketCheckout } from '../../lib/checkout/basket';
import { listOtcFulfilment } from '../../lib/accounts';
import { getProduct } from '../../lib/checkout/products';
import { getOtcProduct } from '../../data/otc-catalogue';

const { user, env } = Astro.locals;
if (!user) return Astro.redirect('/login');

const admin = createAdminClient(env);
const account = await ensureAccount(admin, user.id);
if (account.role === 'clinician') return Astro.redirect('/clinician');

const flags = flagsFromEnv(env);
const isBasket = Astro.url.searchParams.get('basket') === '1';
const product = getProduct(Astro.url.searchParams.get('product') ?? '', flags);
const kind = product?.kind;
const isConsult = kind === 'consult';
const isMedication = kind === 'medication';
const isAddon = kind === 'addon_kit' || kind === 'rescreen';

let problem: string | null = null;
let gate: Awaited<ReturnType<typeof finaliseTreatmentCheckout>> | null = null;
let medGate: Awaited<ReturnType<typeof finaliseMedicationCheckout>> | null = null;
let basketResult: Awaited<ReturnType<typeof finaliseBasketCheckout>> | null = null;
let addonPaid = false;
let consultPaid = false;
if (flags.purchaseEnabled) {
  try {
    const payments = getPayments(env, admin);
    if (isBasket) {
      // Shop S3: finalise the single basket payment, then run the fulfilment
      // router — OTC lines dispatch now; a prescription line enters the journey
      // (screening), gated as today. Never reaches rx_issued.
      const screening = getScreening(env, admin);
      basketResult = await finaliseBasketCheckout(
        admin,
        payments,
        screening,
        account.id,
        account.core_patient_id ?? '',
        flags,
      );
    } else if (isConsult) {
      // Journey C: finalise the consult fee (marks it paid). Paying gates the
      // full-lane booking; the patient books next. No screening gate here.
      await finaliseLatestPending(admin, payments, account.id);
      consultPaid = await hasPaidConsult(admin, account.id);
    } else if (isMedication && account.core_patient_id) {
      // Journey F: finalise the medication pass-through, then advance rx_issued ->
      // dispensing (the script pre-exists from the clinician). Never touches rx_issued.
      medGate = await finaliseMedicationCheckout(
        admin,
        payments,
        getClinicalCore(env, admin),
        getDispensing(env, admin),
        account.id,
        account.core_patient_id,
        medicationBillingFromEnv(env),
        { email: getEmail(env, admin), baseUrl: new URL(Astro.request.url).origin },
      );
    } else if (isAddon) {
      // Journey G: record the add-on fulfilment / monitoring line. No clinical state.
      const result = await finaliseAddonCheckout(admin, payments, account.id, kind as AddonKind);
      addonPaid = result.paid;
    } else if (account.core_patient_id) {
      const screening = getScreening(env, admin);
      gate = await finaliseTreatmentCheckout(admin, payments, screening, account.id, account.core_patient_id);
    }
  } catch (err) {
    problem = err instanceof Error ? err.message : String(err);
  }
}

const journey = await getJourney(admin, account.id);
// Basket mode: the dispatched OTC lines (resolved to names for display) + whether
// a prescription line entered screening.
const dispatchedOtc = isBasket
  ? (await listOtcFulfilment(admin, account.id))
      .map((f) => getOtcProduct(f.ref_id, flags)?.name)
      .filter((n): n is string => Boolean(n))
  : [];
const paid = isBasket
  ? basketResult?.paid === true
  : isConsult
    ? consultPaid
    : isMedication
      ? medGate?.covered === true
      : isAddon
        ? addonPaid
        : gate?.paymentStatus === 'paid';
const onScreening =
  journey?.state === 'screening_kit_sent' ||
  journey?.state === 'sample_received' ||
  journey?.state === 'results_ready';
const onDispensing = journey?.state === 'dispensing' || journey?.state === 'delivered';
---

<Layout title="Payment — Fern" navVariant="patient" user={user} narrow step={4}>
  <div class="wrap-narrow">
    <div class="stack">
      <span class="eyebrow">Your care</span>
      <h1>Payment</h1>
    </div>

    <div class="card step-card stack">
      {problem && <p class="notice notice-error">{problem}</p>}

      {paid && isBasket && (
        <>
          <span class="pill">Paid</span>
          <p>Thank you. Your payment is confirmed. Here is how your basket is being fulfilled.</p>
          {dispatchedOtc.length > 0 && (
            <div class="fgroup">
              <span class="pill">Ships now</span>
              <ul class="fill-list">
                {dispatchedOtc.map((n) => <li>{n}</li>)}
              </ul>
              <p class="muted small">Your shop items are on their way. No clinician needed for these.</p>
            </div>
          )}
          {basketResult?.enteredScreening || onScreening ? (
            <div class="fgroup">
              <span class="pill pill-soft">Pending clinician review</span>
              <p class="muted small">
                For your treatment, we are posting your at-home screening kit. Once
                your results are in, a clinician reviews them before anything is
                prescribed. Nothing has been prescribed.
              </p>
              <a href="/screening" class="link">Track your screening</a>
            </div>
          ) : null}
          <a href="/treatment" class="btn btn-pri">Go to your care</a>
        </>
      )}

      {paid && isConsult && (
        <>
          <span class="pill">Paid</span>
          <p>
            Thank you. Your consultation fee is confirmed. You can now book your
            consultation slot. A clinician decides the next step at the
            consultation. Nothing has been prescribed.
          </p>
          <a href="/consult" class="btn btn-pri">Book your consultation</a>
        </>
      )}

      {paid && isMedication && (
        <>
          <span class="pill">Paid</span>
          <p>
            Thank you. Your treatment is being sent to our pharmacy partner for
            dispensing and delivery. Your prescription has not changed; this
            arranges its dispensing. You can follow progress on your treatment page.
          </p>
          <a href="/treatment" class="btn btn-pri">Track your treatment</a>
        </>
      )}

      {paid && isAddon && (
        <>
          <span class="pill">Paid</span>
          <p>
            Thank you. Your order is confirmed. This is an optional extra and
            nothing about your treatment or your care has changed.
          </p>
          <a href="/treatment" class="link">Back to your treatment</a>
        </>
      )}

      {paid && !isBasket && !isConsult && !isMedication && !isAddon && onScreening && (
        <>
          <span class="pill">Paid</span>
          <p>
            Thank you. Your payment is confirmed and we are posting your at-home
            screening kit. Once your results are in, a clinician reviews them
            before any treatment is discussed. Nothing has been prescribed.
          </p>
          <a href="/screening" class="btn btn-pri">Track your screening</a>
        </>
      )}

      {paid && !isBasket && !isConsult && !isMedication && !isAddon && !onScreening && (
        <>
          <span class="pill">Paid</span>
          <p>Your payment is confirmed. We will be in touch with your next step.</p>
          <a href="/dashboard" class="link">Back to your dashboard</a>
        </>
      )}

      {!paid && !problem && (
        <>
          <span class="pill pill-soft">Confirming</span>
          <p class="muted">
            Your payment is being confirmed. This can take a moment; reload this
            page.
          </p>
        </>
      )}
    </div>

    <p class="soft devline">
      <span class="dev-tag">Demo detail</span>
      payment <code>{isBasket ? (basketResult?.paid ? 'paid' : 'pending') : (gate?.paymentStatus ?? 'none')}</code>
      &middot; state <code>{journey?.state}</code>
    </p>
  </div>
</Layout>

<style>
  .step-card { margin-top: 24px; }
  .step-card .pill { align-self: flex-start; }
  .step-card .btn { align-self: flex-start; }
  .fgroup { margin-top: 8px; padding-top: 12px; border-top: 1px solid var(--border); }
  .fgroup .pill { align-self: flex-start; }
  .fill-list { margin: 10px 0; padding-left: 18px; font-size: 14px; }
  .fill-list li { margin-bottom: 2px; }
  .small { font-size: 13px; }
  .devline { margin-top: 18px; font-size: 12.5px; }
  .dev-tag {
    font-family: var(--mono); font-size: 10px; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--faint); margin-right: 8px;
  }
  code { font-family: var(--mono); font-size: 12.5px; }
</style>
