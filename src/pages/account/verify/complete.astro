---
// Return page from the identity provider (and the mock flow). Polls the current
// provider status and finalises: when verified, advances id_pending ->
// id_verified. For Stripe the webhook is the authoritative path; this poll is a
// belt-and-braces refresh and is idempotent with it. Styled onto the D1 shell
// (D3); the poll + finalise logic is unchanged.
import Layout from '../../../layouts/Layout.astro';
import { createAdminClient } from '../../../lib/supabase/admin';
import { getIdentity } from '../../../lib/adapters/factory';
import { ensureAccount, getJourney, getLatestIdVerification } from '../../../lib/accounts';
import { finaliseVerification } from '../../../lib/verification';

const { user, env } = Astro.locals;
if (!user) return Astro.redirect('/login');

const admin = createAdminClient(env);
const account = await ensureAccount(admin, user.id);

const record = await getLatestIdVerification(admin, account.id);
let status: string | null = null;
let problem: string | null = null;

if (record) {
  try {
    const identity = getIdentity(env, admin);
    const live = await identity.getVerificationStatus(record.provider_ref);
    status = await finaliseVerification(admin, account.id, record.provider_ref, live);
  } catch (err) {
    problem = err instanceof Error ? err.message : String(err);
  }
}

const journey = await getJourney(admin, account.id);
const verified = journey?.state === 'id_verified';
---

<Layout title="ID check — Fern" navVariant="onboarding" user={user} narrow step={2}>
  <div class="wrap-narrow">
    <div class="stack">
      <span class="steps">Step 2 of 2 &middot; Identity</span>
      <h1>ID check</h1>
    </div>

    <div class="card result-card stack">
      {problem && <p class="notice notice-error">{problem}</p>}

      {
        verified ? (
          <>
            <span class="pill">Verified</span>
            <p class="muted">
              Your identity is verified. You can continue to the next step.
            </p>
            <a href="/intake" class="btn btn-pri btn-block">Continue to intake</a>
          </>
        ) : (
          <>
            <span class="pill pill-soft">In progress</span>
            <p class="muted">
              Not verified yet. Verification can take a moment. Reload this page,
              or start a new check.
            </p>
            <a href="/account/verify" class="btn btn-ghost btn-block">Start a new check</a>
          </>
        )
      }

      <p class="soft provider">
        Provider status: <code>{status ?? '(none)'}</code> &middot; journey state:{' '}
        <code>{journey?.state ?? '(none)'}</code>
      </p>
    </div>
  </div>
</Layout>

<style>
  .result-card { margin-top: 28px; }
  .provider { margin-top: 4px; font-size: 13px; }
  code { font-family: var(--mono); font-size: 12.5px; }
</style>
