---
// In-app stand-in for the provider's billing portal, used only when
// PAYMENTS_IMPL=mock. It plays the role of Stripe's customer portal: the member
// can cancel here. The real Stripe test-mode portal replaces this page entirely;
// a cancel there arrives via the customer.subscription.deleted webhook.
// Styled onto the D1 shell (D2), clearly fenced as a demo stand-in.
import Layout from '../../../layouts/Layout.astro';
const { user } = Astro.locals;
if (!user) return Astro.redirect('/login');

const customer = Astro.url.searchParams.get('customer') ?? '';
const ret = Astro.url.searchParams.get('return') ?? '/account/billing';
---

<Layout title="Manage membership — Fern" navVariant="patient" user={user} narrow step={4}>
  <div class="wrap-narrow">
    <div class="stack">
      <span class="pill pill-soft">Demo stand-in</span>
      <h1>Manage membership</h1>
      <p class="lede">
        This stands in for the customer billing portal. The live portal is hosted
        by the payment provider.
      </p>
    </div>

    <div class="card portal-card stack">
      <p class="muted">Your membership is active. You can cancel it below.</p>
      <form method="POST" action="/api/payments/mock-portal-cancel">
        <button type="submit" class="btn btn-ghost">Cancel membership</button>
      </form>
      <p class="soft devline">
        <span class="dev-tag">Customer</span><code>{customer || 'none'}</code>
      </p>
    </div>

    <p class="soft alt"><a href={ret} class="link">Back to billing</a></p>
  </div>
</Layout>

<style>
  .portal-card { margin-top: 26px; }
  .portal-card form { margin: 0; }
  .devline { margin-top: 4px; font-size: 12.5px; }
  .dev-tag {
    font-family: var(--mono); font-size: 10px; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--faint); margin-right: 8px;
  }
  code { font-family: var(--mono); font-size: 12.5px; }
  .alt { margin-top: 18px; text-align: center; }
</style>
